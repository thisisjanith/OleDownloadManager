{
  "manifest_version": 3,
  "name": "OleDownloadManager",
  "version": "1.0.0",
  "description": "Send downloads to the OleDownloadManager app on your Mac.",
  "browser_specific_settings": { "gecko": { "id": "oledownloadmanager@oledownloadmanager.app", "strict_min_version": "115.0" } },
  "permissions": ["nativeMessaging", "contextMenus", "downloads", "storage"],
  "background": { "scripts": ["logic.js", "background.js"] },
  "action": { "default_popup": "popup.html", "default_title": "OleDownloadManager", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
